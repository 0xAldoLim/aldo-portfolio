# Optional. Raises GitHub public API rate limits. Server-side only.
GITHUB_TOKEN=

# Optional. Enables contact form delivery through Resend.
RESEND_API_KEY=

# Optional. A Resend-verified sender, for example Portfolio <contact@yourdomain.com>.
RESEND_FROM_EMAIL=

# Optional. Enables persistent rate limiting and the visitor counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public canonical site URL used by metadata, sitemap, origin checks, and email context.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
